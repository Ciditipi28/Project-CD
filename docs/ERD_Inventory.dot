digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.5", ranksep="1.0", fontname="Arial", fontsize=22, label="Ingredient inventory and purchasing", labelloc=t];
node [shape=plain, fontname="Arial"];
edge [color="#9bab9b", arrowsize=.65, fontname="Arial", fontsize=9];
units [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>units</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_id"><FONT POINT-SIZE="10">PK unit_id</FONT></TD><TD ALIGN="LEFT" PORT="unit_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR></TABLE>>];
inventory_items [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>inventory_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="inventory_item_id"><FONT POINT-SIZE="10">PK inventory_item_id</FONT></TD><TD ALIGN="LEFT" PORT="inventory_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_id"><FONT POINT-SIZE="10">FK unit_id</FONT></TD><TD ALIGN="LEFT" PORT="unit_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="10">name</FONT></TD><TD ALIGN="LEFT" PORT="name_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR></TABLE>>];
suppliers [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>suppliers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="supplier_id"><FONT POINT-SIZE="10">PK supplier_id</FONT></TD><TD ALIGN="LEFT" PORT="supplier_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="10">name</FONT></TD><TD ALIGN="LEFT" PORT="name_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR></TABLE>>];
stock_receipts [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>stock_receipts</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stock_receipt_id"><FONT POINT-SIZE="10">PK stock_receipt_id</FONT></TD><TD ALIGN="LEFT" PORT="stock_receipt_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="supplier_id"><FONT POINT-SIZE="10">FK supplier_id</FONT></TD><TD ALIGN="LEFT" PORT="supplier_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="received_by"><FONT POINT-SIZE="10">FK received_by</FONT></TD><TD ALIGN="LEFT" PORT="received_by_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cash_session_id"><FONT POINT-SIZE="10">FK cash_session_id</FONT></TD><TD ALIGN="LEFT" PORT="cash_session_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT" PORT="status_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR></TABLE>>];
stock_receipt_items [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>stock_receipt_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stock_receipt_item_id"><FONT POINT-SIZE="10">PK stock_receipt_item_id</FONT></TD><TD ALIGN="LEFT" PORT="stock_receipt_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stock_receipt_id"><FONT POINT-SIZE="10">FK stock_receipt_id</FONT></TD><TD ALIGN="LEFT" PORT="stock_receipt_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="inventory_item_id"><FONT POINT-SIZE="10">FK inventory_item_id</FONT></TD><TD ALIGN="LEFT" PORT="inventory_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity"><FONT POINT-SIZE="10">quantity</FONT></TD><TD ALIGN="LEFT" PORT="quantity_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,3)</FONT></TD></TR></TABLE>>];
stock_movements [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>stock_movements</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="movement_id"><FONT POINT-SIZE="10">PK movement_id</FONT></TD><TD ALIGN="LEFT" PORT="movement_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="inventory_item_id"><FONT POINT-SIZE="10">FK inventory_item_id</FONT></TD><TD ALIGN="LEFT" PORT="inventory_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stock_receipt_item_id"><FONT POINT-SIZE="10">FK stock_receipt_item_id</FONT></TD><TD ALIGN="LEFT" PORT="stock_receipt_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity_change"><FONT POINT-SIZE="10">quantity_change</FONT></TD><TD ALIGN="LEFT" PORT="quantity_change_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="recorded_by"><FONT POINT-SIZE="10">FK recorded_by</FONT></TD><TD ALIGN="LEFT" PORT="recorded_by_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR></TABLE>>];
users [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT POINT-SIZE="10">PK user_id</FONT></TD><TD ALIGN="LEFT" PORT="user_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_id"><FONT POINT-SIZE="10">FK role_id</FONT></TD><TD ALIGN="LEFT" PORT="role_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="username"><FONT POINT-SIZE="10">username</FONT></TD><TD ALIGN="LEFT" PORT="username_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(50)</FONT></TD></TR></TABLE>>];
cash_sessions [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>cash_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cash_session_id"><FONT POINT-SIZE="10">PK cash_session_id</FONT></TD><TD ALIGN="LEFT" PORT="cash_session_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT POINT-SIZE="10">FK user_id</FONT></TD><TD ALIGN="LEFT" PORT="user_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT" PORT="status_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR></TABLE>>];
units:unit_id_out:e -> inventory_items:unit_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="units.unit_id to inventory_items.unit_id"];
suppliers:supplier_id_out:e -> stock_receipts:supplier_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="suppliers.supplier_id to stock_receipts.supplier_id"];
users:user_id_out:e -> stock_receipts:received_by:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="users.user_id to stock_receipts.received_by"];
cash_sessions:cash_session_id_out:e -> stock_receipts:cash_session_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="cash_sessions.cash_session_id to stock_receipts.cash_session_id"];
stock_receipts:stock_receipt_id_out:e -> stock_receipt_items:stock_receipt_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="stock_receipts.stock_receipt_id to stock_receipt_items.stock_receipt_id"];
inventory_items:inventory_item_id_out:e -> stock_receipt_items:inventory_item_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="inventory_items.inventory_item_id to stock_receipt_items.inventory_item_id"];
inventory_items:inventory_item_id_out:e -> stock_movements:inventory_item_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="inventory_items.inventory_item_id to stock_movements.inventory_item_id"];
stock_receipt_items:stock_receipt_item_id_out:e -> stock_movements:stock_receipt_item_id:w [dir=both,arrowtail=tee,arrowhead=tee,tooltip="stock_receipt_items.stock_receipt_item_id to stock_movements.stock_receipt_item_id"];
users:user_id_out:e -> stock_movements:recorded_by:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="users.user_id to stock_movements.recorded_by"];
users:user_id_out:e -> cash_sessions:user_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="users.user_id to cash_sessions.user_id"];
}