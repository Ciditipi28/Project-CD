digraph flow {
graph [rankdir=TB,bgcolor="white",pad=.5,fontname="Arial",fontsize=22,label="CarinderEase daily system flow",labelloc=t,nodesep=.6,ranksep=.4];
node [shape=box,style="rounded,filled",fillcolor="#f1f5ec",color="#c4d3b9",fontname="Arial",fontsize=12,margin=".18,.13"];
edge [color="#79916f",fontname="Arial",fontsize=10];
login[label="Log in"];auth[label="Valid active account?",shape=diamond,fillcolor="#fcf0dc"];dashboard[label="Role dashboard"];menu[label="Publish daily menu and portions"];drawer[label="Open cashier session"];order[label="Select customer order"];stock[label="All portions available?",shape=diamond,fillcolor="#fcf0dc"];cash[label="Enter cash received"];enough[label="Cash sufficient?",shape=diamond,fillcolor="#fcf0dc"];save[label="Save sale, payment and servings\nin one database transaction",fillcolor="#173e32",fontcolor=white];serve[label="Print slip and serve meal"];refill[label="Eligible refill requested?",shape=diamond,fillcolor="#fcf0dc"];check[label="Check visit eligibility and rice stock"];record[label="Record one free rice serving"];visit[label="Close visit"];closing[label="Record waste and expenses"];count[label="Count cash and close drawer"];
login->auth;auth->login[label="No"];auth->dashboard[label="Yes"];dashboard->menu->drawer->order->stock;stock->order[label="No"];stock->cash[label="Yes"];cash->enough;enough->cash[label="No"];enough->save[label="Yes"];save->serve->refill;refill->check[label="Yes"];check->record[label="Eligible and available"];check->refill[label="Unavailable / ineligible"];record->refill;refill->visit[label="Visit ends"];visit->closing->count;
}
