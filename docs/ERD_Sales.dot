digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.5", ranksep="1.0", fontname="Arial", fontsize=22, label="Sales and serving records", labelloc=t];
node [shape=plain, fontname="Arial"];
edge [color="#9bab9b", arrowsize=.65, fontname="Arial", fontsize=9];
users [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT POINT-SIZE="10">PK user_id</FONT></TD><TD ALIGN="LEFT" PORT="user_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_id"><FONT POINT-SIZE="10">FK role_id</FONT></TD><TD ALIGN="LEFT" PORT="role_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="username"><FONT POINT-SIZE="10">username</FONT></TD><TD ALIGN="LEFT" PORT="username_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(50)</FONT></TD></TR></TABLE>>];
cash_sessions [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>cash_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cash_session_id"><FONT POINT-SIZE="10">PK cash_session_id</FONT></TD><TD ALIGN="LEFT" PORT="cash_session_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT POINT-SIZE="10">FK user_id</FONT></TD><TD ALIGN="LEFT" PORT="user_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT" PORT="status_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR></TABLE>>];
sales [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>sales</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><FONT POINT-SIZE="10">PK sale_id</FONT></TD><TD ALIGN="LEFT" PORT="sale_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cash_session_id"><FONT POINT-SIZE="10">FK cash_session_id</FONT></TD><TD ALIGN="LEFT" PORT="cash_session_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount"><FONT POINT-SIZE="10">total_amount</FONT></TD><TD ALIGN="LEFT" PORT="total_amount_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR></TABLE>>];
payments [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="payment_id"><FONT POINT-SIZE="10">PK payment_id</FONT></TD><TD ALIGN="LEFT" PORT="payment_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><FONT POINT-SIZE="10">FK sale_id</FONT></TD><TD ALIGN="LEFT" PORT="sale_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR></TABLE>>];
sale_items [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>sale_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_item_id"><FONT POINT-SIZE="10">PK sale_item_id</FONT></TD><TD ALIGN="LEFT" PORT="sale_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><FONT POINT-SIZE="10">FK sale_id</FONT></TD><TD ALIGN="LEFT" PORT="sale_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="daily_menu_item_id"><FONT POINT-SIZE="10">FK daily_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="daily_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity"><FONT POINT-SIZE="10">quantity</FONT></TD><TD ALIGN="LEFT" PORT="quantity_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="refill_menu_item_id"><FONT POINT-SIZE="10">FK refill_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="refill_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="refill_closed_by"><FONT POINT-SIZE="10">FK refill_closed_by</FONT></TD><TD ALIGN="LEFT" PORT="refill_closed_by_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR></TABLE>>];
sale_item_components [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>sale_item_components</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="serving_id"><FONT POINT-SIZE="10">PK serving_id</FONT></TD><TD ALIGN="LEFT" PORT="serving_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_item_id"><FONT POINT-SIZE="10">FK sale_item_id</FONT></TD><TD ALIGN="LEFT" PORT="sale_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="daily_menu_item_id"><FONT POINT-SIZE="10">FK daily_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="daily_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity"><FONT POINT-SIZE="10">quantity</FONT></TD><TD ALIGN="LEFT" PORT="quantity_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="served_by"><FONT POINT-SIZE="10">FK served_by</FONT></TD><TD ALIGN="LEFT" PORT="served_by_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR></TABLE>>];
daily_menu_items [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>daily_menu_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="daily_menu_item_id"><FONT POINT-SIZE="10">PK daily_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="daily_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="menu_item_id"><FONT POINT-SIZE="10">FK menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="menu_date"><FONT POINT-SIZE="10">menu_date</FONT></TD><TD ALIGN="LEFT" PORT="menu_date_out"><FONT COLOR="#768370" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="selling_price"><FONT POINT-SIZE="10">selling_price</FONT></TD><TD ALIGN="LEFT" PORT="selling_price_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prepared_qty"><FONT POINT-SIZE="10">prepared_qty</FONT></TD><TD ALIGN="LEFT" PORT="prepared_qty_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="wasted_qty"><FONT POINT-SIZE="10">wasted_qty</FONT></TD><TD ALIGN="LEFT" PORT="wasted_qty_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_by"><FONT POINT-SIZE="10">FK updated_by</FONT></TD><TD ALIGN="LEFT" PORT="updated_by_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR></TABLE>>];
menu_items [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>menu_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="menu_item_id"><FONT POINT-SIZE="10">PK menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><FONT POINT-SIZE="10">FK category_id</FONT></TD><TD ALIGN="LEFT" PORT="category_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="10">name</FONT></TD><TD ALIGN="LEFT" PORT="name_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="refill_menu_item_id"><FONT POINT-SIZE="10">FK refill_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="refill_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR></TABLE>>];
users:user_id_out:e -> cash_sessions:user_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="users.user_id to cash_sessions.user_id"];
cash_sessions:cash_session_id_out:e -> sales:cash_session_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="cash_sessions.cash_session_id to sales.cash_session_id"];
sales:sale_id_out:e -> payments:sale_id:w [dir=both,arrowtail=tee,arrowhead=tee,tooltip="sales.sale_id to payments.sale_id"];
sales:sale_id_out:e -> sale_items:sale_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="sales.sale_id to sale_items.sale_id"];
daily_menu_items:daily_menu_item_id_out:e -> sale_items:daily_menu_item_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="daily_menu_items.daily_menu_item_id to sale_items.daily_menu_item_id"];
menu_items:menu_item_id_out:e -> sale_items:refill_menu_item_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="menu_items.menu_item_id to sale_items.refill_menu_item_id"];
users:user_id_out:e -> sale_items:refill_closed_by:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="users.user_id to sale_items.refill_closed_by"];
sale_items:sale_item_id_out:e -> sale_item_components:sale_item_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="sale_items.sale_item_id to sale_item_components.sale_item_id"];
daily_menu_items:daily_menu_item_id_out:e -> sale_item_components:daily_menu_item_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="daily_menu_items.daily_menu_item_id to sale_item_components.daily_menu_item_id"];
users:user_id_out:e -> sale_item_components:served_by:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="users.user_id to sale_item_components.served_by"];
menu_items:menu_item_id_out:e -> daily_menu_items:menu_item_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="menu_items.menu_item_id to daily_menu_items.menu_item_id"];
users:user_id_out:e -> daily_menu_items:updated_by:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="users.user_id to daily_menu_items.updated_by"];
menu_items:menu_item_id_out:e -> menu_items:refill_menu_item_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="menu_items.menu_item_id to menu_items.refill_menu_item_id"];
}