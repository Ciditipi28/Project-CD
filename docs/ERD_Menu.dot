digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.5", ranksep="1.0", fontname="Arial", fontsize=22, label="Accounts and daily menu", labelloc=t];
node [shape=plain, fontname="Arial"];
edge [color="#9bab9b", arrowsize=.65, fontname="Arial", fontsize=9];
roles [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_id"><FONT POINT-SIZE="10">PK role_id</FONT></TD><TD ALIGN="LEFT" PORT="role_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_name"><FONT POINT-SIZE="10">role_name</FONT></TD><TD ALIGN="LEFT" PORT="role_name_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(30)</FONT></TD></TR></TABLE>>];
users [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT POINT-SIZE="10">PK user_id</FONT></TD><TD ALIGN="LEFT" PORT="user_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_id"><FONT POINT-SIZE="10">FK role_id</FONT></TD><TD ALIGN="LEFT" PORT="role_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="username"><FONT POINT-SIZE="10">username</FONT></TD><TD ALIGN="LEFT" PORT="username_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(50)</FONT></TD></TR></TABLE>>];
menu_categories [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>menu_categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><FONT POINT-SIZE="10">PK category_id</FONT></TD><TD ALIGN="LEFT" PORT="category_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="10">name</FONT></TD><TD ALIGN="LEFT" PORT="name_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(50)</FONT></TD></TR></TABLE>>];
menu_items [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>menu_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="menu_item_id"><FONT POINT-SIZE="10">PK menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><FONT POINT-SIZE="10">FK category_id</FONT></TD><TD ALIGN="LEFT" PORT="category_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="10">name</FONT></TD><TD ALIGN="LEFT" PORT="name_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="refill_menu_item_id"><FONT POINT-SIZE="10">FK refill_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="refill_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR></TABLE>>];
daily_menu_items [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>daily_menu_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="daily_menu_item_id"><FONT POINT-SIZE="10">PK daily_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="daily_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="menu_item_id"><FONT POINT-SIZE="10">FK menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="menu_date"><FONT POINT-SIZE="10">menu_date</FONT></TD><TD ALIGN="LEFT" PORT="menu_date_out"><FONT COLOR="#768370" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="selling_price"><FONT POINT-SIZE="10">selling_price</FONT></TD><TD ALIGN="LEFT" PORT="selling_price_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prepared_qty"><FONT POINT-SIZE="10">prepared_qty</FONT></TD><TD ALIGN="LEFT" PORT="prepared_qty_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="wasted_qty"><FONT POINT-SIZE="10">wasted_qty</FONT></TD><TD ALIGN="LEFT" PORT="wasted_qty_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_by"><FONT POINT-SIZE="10">FK updated_by</FONT></TD><TD ALIGN="LEFT" PORT="updated_by_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR></TABLE>>];
combo_components [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>combo_components</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="combo_component_id"><FONT POINT-SIZE="10">PK combo_component_id</FONT></TD><TD ALIGN="LEFT" PORT="combo_component_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="combo_menu_item_id"><FONT POINT-SIZE="10">FK combo_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="combo_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="component_menu_item_id"><FONT POINT-SIZE="10">FK component_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="component_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity"><FONT POINT-SIZE="10">quantity</FONT></TD><TD ALIGN="LEFT" PORT="quantity_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR></TABLE>>];
roles:role_id_out:e -> users:role_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="roles.role_id to users.role_id"];
menu_categories:category_id_out:e -> menu_items:category_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="menu_categories.category_id to menu_items.category_id"];
menu_items:menu_item_id_out:e -> menu_items:refill_menu_item_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="menu_items.menu_item_id to menu_items.refill_menu_item_id"];
menu_items:menu_item_id_out:e -> daily_menu_items:menu_item_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="menu_items.menu_item_id to daily_menu_items.menu_item_id"];
users:user_id_out:e -> daily_menu_items:updated_by:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="users.user_id to daily_menu_items.updated_by"];
menu_items:menu_item_id_out:e -> combo_components:combo_menu_item_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="menu_items.menu_item_id to combo_components.combo_menu_item_id"];
menu_items:menu_item_id_out:e -> combo_components:component_menu_item_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="menu_items.menu_item_id to combo_components.component_menu_item_id"];
}