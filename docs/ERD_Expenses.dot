digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.5", ranksep="1.0", fontname="Arial", fontsize=22, label="Expenses and accountability", labelloc=t];
node [shape=plain, fontname="Arial"];
edge [color="#9bab9b", arrowsize=.65, fontname="Arial", fontsize=9];
users [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT POINT-SIZE="10">PK user_id</FONT></TD><TD ALIGN="LEFT" PORT="user_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_id"><FONT POINT-SIZE="10">FK role_id</FONT></TD><TD ALIGN="LEFT" PORT="role_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="username"><FONT POINT-SIZE="10">username</FONT></TD><TD ALIGN="LEFT" PORT="username_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(50)</FONT></TD></TR></TABLE>>];
cash_sessions [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>cash_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cash_session_id"><FONT POINT-SIZE="10">PK cash_session_id</FONT></TD><TD ALIGN="LEFT" PORT="cash_session_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT POINT-SIZE="10">FK user_id</FONT></TD><TD ALIGN="LEFT" PORT="user_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT" PORT="status_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR></TABLE>>];
expense_categories [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>expense_categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expense_category_id"><FONT POINT-SIZE="10">PK expense_category_id</FONT></TD><TD ALIGN="LEFT" PORT="expense_category_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="10">name</FONT></TD><TD ALIGN="LEFT" PORT="name_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(50)</FONT></TD></TR></TABLE>>];
expenses [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>expenses</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expense_id"><FONT POINT-SIZE="10">PK expense_id</FONT></TD><TD ALIGN="LEFT" PORT="expense_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expense_category_id"><FONT POINT-SIZE="10">FK expense_category_id</FONT></TD><TD ALIGN="LEFT" PORT="expense_category_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="amount"><FONT POINT-SIZE="10">amount</FONT></TD><TD ALIGN="LEFT" PORT="amount_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cash_session_id"><FONT POINT-SIZE="10">FK cash_session_id</FONT></TD><TD ALIGN="LEFT" PORT="cash_session_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="recorded_by"><FONT POINT-SIZE="10">FK recorded_by</FONT></TD><TD ALIGN="LEFT" PORT="recorded_by_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR></TABLE>>];
audit_logs [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>audit_logs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="audit_log_id"><FONT POINT-SIZE="10">PK audit_log_id</FONT></TD><TD ALIGN="LEFT" PORT="audit_log_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT POINT-SIZE="10">FK user_id</FONT></TD><TD ALIGN="LEFT" PORT="user_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="action"><FONT POINT-SIZE="10">action</FONT></TD><TD ALIGN="LEFT" PORT="action_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(50)</FONT></TD></TR></TABLE>>];
users:user_id_out:e -> cash_sessions:user_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="users.user_id to cash_sessions.user_id"];
expense_categories:expense_category_id_out:e -> expenses:expense_category_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="expense_categories.expense_category_id to expenses.expense_category_id"];
cash_sessions:cash_session_id_out:e -> expenses:cash_session_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="cash_sessions.cash_session_id to expenses.cash_session_id"];
users:user_id_out:e -> expenses:recorded_by:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="users.user_id to expenses.recorded_by"];
users:user_id_out:e -> audit_logs:user_id:w [dir=both,arrowtail=tee,arrowhead=crow,tooltip="users.user_id to audit_logs.user_id"];
}