digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.5", ranksep="1.0", fontname="Arial", fontsize=22, label="CarinderEase Family complete ERD", labelloc=t];
node [shape=plain, fontname="Arial"];
edge [color="#9bab9b", arrowsize=.65, fontname="Arial", fontsize=9];
roles [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_id"><FONT POINT-SIZE="10">PK role_id</FONT></TD><TD ALIGN="LEFT" PORT="role_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_name"><FONT POINT-SIZE="10">role_name</FONT></TD><TD ALIGN="LEFT" PORT="role_name_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description"><FONT POINT-SIZE="10">description</FONT></TD><TD ALIGN="LEFT" PORT="description_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(255)</FONT></TD></TR></TABLE>>];
users [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT">UQ owner_guard</TD><TD ALIGN="LEFT">TINYINT generated</TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT POINT-SIZE="10">PK user_id</FONT></TD><TD ALIGN="LEFT" PORT="user_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="role_id"><FONT POINT-SIZE="10">FK role_id</FONT></TD><TD ALIGN="LEFT" PORT="role_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name"><FONT POINT-SIZE="10">full_name</FONT></TD><TD ALIGN="LEFT" PORT="full_name_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="username"><FONT POINT-SIZE="10">username</FONT></TD><TD ALIGN="LEFT" PORT="username_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash"><FONT POINT-SIZE="10">password_hash</FONT></TD><TD ALIGN="LEFT" PORT="password_hash_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active"><FONT POINT-SIZE="10">is_active</FONT></TD><TD ALIGN="LEFT" PORT="is_active_out"><FONT COLOR="#768370" POINT-SIZE="9">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="10">created_at</FONT></TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#768370" POINT-SIZE="9">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="10">updated_at</FONT></TD><TD ALIGN="LEFT" PORT="updated_at_out"><FONT COLOR="#768370" POINT-SIZE="9">DATETIME</FONT></TD></TR></TABLE>>];
menu_categories [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>menu_categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><FONT POINT-SIZE="10">PK category_id</FONT></TD><TD ALIGN="LEFT" PORT="category_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="10">name</FONT></TD><TD ALIGN="LEFT" PORT="name_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active"><FONT POINT-SIZE="10">is_active</FONT></TD><TD ALIGN="LEFT" PORT="is_active_out"><FONT COLOR="#768370" POINT-SIZE="9">BOOLEAN</FONT></TD></TR></TABLE>>];
menu_items [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>menu_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="menu_item_id"><FONT POINT-SIZE="10">PK menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><FONT POINT-SIZE="10">FK category_id</FONT></TD><TD ALIGN="LEFT" PORT="category_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="10">name</FONT></TD><TD ALIGN="LEFT" PORT="name_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="item_type"><FONT POINT-SIZE="10">item_type</FONT></TD><TD ALIGN="LEFT" PORT="item_type_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="standard_price"><FONT POINT-SIZE="10">standard_price</FONT></TD><TD ALIGN="LEFT" PORT="standard_price_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="includes_unli_rice"><FONT POINT-SIZE="10">includes_unli_rice</FONT></TD><TD ALIGN="LEFT" PORT="includes_unli_rice_out"><FONT COLOR="#768370" POINT-SIZE="9">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="refill_menu_item_id"><FONT POINT-SIZE="10">FK refill_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="refill_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active"><FONT POINT-SIZE="10">is_active</FONT></TD><TD ALIGN="LEFT" PORT="is_active_out"><FONT COLOR="#768370" POINT-SIZE="9">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="10">created_at</FONT></TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#768370" POINT-SIZE="9">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="10">updated_at</FONT></TD><TD ALIGN="LEFT" PORT="updated_at_out"><FONT COLOR="#768370" POINT-SIZE="9">DATETIME</FONT></TD></TR></TABLE>>];
daily_menu_items [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>daily_menu_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="daily_menu_item_id"><FONT POINT-SIZE="10">PK daily_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="daily_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="menu_item_id"><FONT POINT-SIZE="10">FK menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="menu_date"><FONT POINT-SIZE="10">menu_date</FONT></TD><TD ALIGN="LEFT" PORT="menu_date_out"><FONT COLOR="#768370" POINT-SIZE="9">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="selling_price"><FONT POINT-SIZE="10">selling_price</FONT></TD><TD ALIGN="LEFT" PORT="selling_price_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prepared_qty"><FONT POINT-SIZE="10">prepared_qty</FONT></TD><TD ALIGN="LEFT" PORT="prepared_qty_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="wasted_qty"><FONT POINT-SIZE="10">wasted_qty</FONT></TD><TD ALIGN="LEFT" PORT="wasted_qty_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_enabled"><FONT POINT-SIZE="10">is_enabled</FONT></TD><TD ALIGN="LEFT" PORT="is_enabled_out"><FONT COLOR="#768370" POINT-SIZE="9">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_by"><FONT POINT-SIZE="10">FK updated_by</FONT></TD><TD ALIGN="LEFT" PORT="updated_by_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="10">created_at</FONT></TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#768370" POINT-SIZE="9">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="10">updated_at</FONT></TD><TD ALIGN="LEFT" PORT="updated_at_out"><FONT COLOR="#768370" POINT-SIZE="9">DATETIME</FONT></TD></TR></TABLE>>];
combo_components [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>combo_components</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="combo_component_id"><FONT POINT-SIZE="10">PK combo_component_id</FONT></TD><TD ALIGN="LEFT" PORT="combo_component_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="combo_menu_item_id"><FONT POINT-SIZE="10">FK combo_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="combo_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="component_menu_item_id"><FONT POINT-SIZE="10">FK component_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="component_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity"><FONT POINT-SIZE="10">quantity</FONT></TD><TD ALIGN="LEFT" PORT="quantity_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR></TABLE>>];
cash_sessions [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>cash_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cash_session_id"><FONT POINT-SIZE="10">PK cash_session_id</FONT></TD><TD ALIGN="LEFT" PORT="cash_session_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><FONT POINT-SIZE="10">FK user_id</FONT></TD><TD ALIGN="LEFT" PORT="user_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="opened_at"><FONT POINT-SIZE="10">opened_at</FONT></TD><TD ALIGN="LEFT" PORT="opened_at_out"><FONT COLOR="#768370" POINT-SIZE="9">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="closed_at"><FONT POINT-SIZE="10">closed_at</FONT></TD><TD ALIGN="LEFT" PORT="closed_at_out"><FONT COLOR="#768370" POINT-SIZE="9">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="opening_float"><FONT POINT-SIZE="10">opening_float</FONT></TD><TD ALIGN="LEFT" PORT="opening_float_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="counted_cash"><FONT POINT-SIZE="10">counted_cash</FONT></TD><TD ALIGN="LEFT" PORT="counted_cash_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT" PORT="status_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="open_guard"><FONT POINT-SIZE="10">open_guard</FONT></TD><TD ALIGN="LEFT" PORT="open_guard_out"><FONT COLOR="#768370" POINT-SIZE="9">TINYINT</FONT></TD></TR></TABLE>>];
sales [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>sales</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><FONT POINT-SIZE="10">PK sale_id</FONT></TD><TD ALIGN="LEFT" PORT="sale_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_number"><FONT POINT-SIZE="10">sale_number</FONT></TD><TD ALIGN="LEFT" PORT="sale_number_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(30)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="checkout_token"><FONT POINT-SIZE="10">checkout_token</FONT></TD><TD ALIGN="LEFT" PORT="checkout_token_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cash_session_id"><FONT POINT-SIZE="10">FK cash_session_id</FONT></TD><TD ALIGN="LEFT" PORT="cash_session_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sold_at"><FONT POINT-SIZE="10">sold_at</FONT></TD><TD ALIGN="LEFT" PORT="sold_at_out"><FONT COLOR="#768370" POINT-SIZE="9">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_type"><FONT POINT-SIZE="10">order_type</FONT></TD><TD ALIGN="LEFT" PORT="order_type_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount"><FONT POINT-SIZE="10">total_amount</FONT></TD><TD ALIGN="LEFT" PORT="total_amount_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR></TABLE>>];
sale_items [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>sale_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_item_id"><FONT POINT-SIZE="10">PK sale_item_id</FONT></TD><TD ALIGN="LEFT" PORT="sale_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><FONT POINT-SIZE="10">FK sale_id</FONT></TD><TD ALIGN="LEFT" PORT="sale_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="daily_menu_item_id"><FONT POINT-SIZE="10">FK daily_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="daily_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="item_name_snapshot"><FONT POINT-SIZE="10">item_name_snapshot</FONT></TD><TD ALIGN="LEFT" PORT="item_name_snapshot_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity"><FONT POINT-SIZE="10">quantity</FONT></TD><TD ALIGN="LEFT" PORT="quantity_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price"><FONT POINT-SIZE="10">unit_price</FONT></TD><TD ALIGN="LEFT" PORT="unit_price_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unli_rice_granted"><FONT POINT-SIZE="10">unli_rice_granted</FONT></TD><TD ALIGN="LEFT" PORT="unli_rice_granted_out"><FONT COLOR="#768370" POINT-SIZE="9">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="refill_menu_item_id"><FONT POINT-SIZE="10">FK refill_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="refill_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="refill_closed_at"><FONT POINT-SIZE="10">refill_closed_at</FONT></TD><TD ALIGN="LEFT" PORT="refill_closed_at_out"><FONT COLOR="#768370" POINT-SIZE="9">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="refill_closed_by"><FONT POINT-SIZE="10">FK refill_closed_by</FONT></TD><TD ALIGN="LEFT" PORT="refill_closed_by_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR></TABLE>>];
sale_item_components [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>sale_item_components</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="serving_id"><FONT POINT-SIZE="10">PK serving_id</FONT></TD><TD ALIGN="LEFT" PORT="serving_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_item_id"><FONT POINT-SIZE="10">FK sale_item_id</FONT></TD><TD ALIGN="LEFT" PORT="sale_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="daily_menu_item_id"><FONT POINT-SIZE="10">FK daily_menu_item_id</FONT></TD><TD ALIGN="LEFT" PORT="daily_menu_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity"><FONT POINT-SIZE="10">quantity</FONT></TD><TD ALIGN="LEFT" PORT="quantity_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="serving_type"><FONT POINT-SIZE="10">serving_type</FONT></TD><TD ALIGN="LEFT" PORT="serving_type_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="operation_token"><FONT POINT-SIZE="10">operation_token</FONT></TD><TD ALIGN="LEFT" PORT="operation_token_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="served_by"><FONT POINT-SIZE="10">FK served_by</FONT></TD><TD ALIGN="LEFT" PORT="served_by_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="served_at"><FONT POINT-SIZE="10">served_at</FONT></TD><TD ALIGN="LEFT" PORT="served_at_out"><FONT COLOR="#768370" POINT-SIZE="9">DATETIME</FONT></TD></TR></TABLE>>];
payments [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="payment_id"><FONT POINT-SIZE="10">PK payment_id</FONT></TD><TD ALIGN="LEFT" PORT="payment_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><FONT POINT-SIZE="10">FK sale_id</FONT></TD><TD ALIGN="LEFT" PORT="sale_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="amount_paid"><FONT POINT-SIZE="10">amount_paid</FONT></TD><TD ALIGN="LEFT" PORT="amount_paid_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cash_tendered"><FONT POINT-SIZE="10">cash_tendered</FONT></TD><TD ALIGN="LEFT" PORT="cash_tendered_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="change_given"><FONT POINT-SIZE="10">change_given</FONT></TD><TD ALIGN="LEFT" PORT="change_given_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="paid_at"><FONT POINT-SIZE="10">paid_at</FONT></TD><TD ALIGN="LEFT" PORT="paid_at_out"><FONT COLOR="#768370" POINT-SIZE="9">DATETIME</FONT></TD></TR></TABLE>>];
