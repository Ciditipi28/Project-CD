inventory_items [label=<<TABLE BORDER="0" CELLBORDER="1" COLOR="#dfe5d8" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#173e32" COLSPAN="2"><FONT COLOR="white"><B>inventory_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="inventory_item_id"><FONT POINT-SIZE="10">PK inventory_item_id</FONT></TD><TD ALIGN="LEFT" PORT="inventory_item_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_id"><FONT POINT-SIZE="10">FK unit_id</FONT></TD><TD ALIGN="LEFT" PORT="unit_id_out"><FONT COLOR="#768370" POINT-SIZE="9">INT UNSIGNED</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name"><FONT POINT-SIZE="10">name</FONT></TD><TD ALIGN="LEFT" PORT="name_out"><FONT COLOR="#768370" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reorder_level"><FONT POINT-SIZE="10">reorder_level</FONT></TD><TD ALIGN="LEFT" PORT="reorder_level_out"><FONT COLOR="#768370" POINT-SIZE="9">DECIMAL(12,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active"><FONT POINT-SIZE="10">is_active</FONT></TD><TD ALIGN="LEFT" PORT="is_active_out"><FONT COLOR="#768370" POINT-SIZE="9">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="10">created_at</FONT></TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#768370" POINT-SIZE="9">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="10">updated_at</FONT></TD><TD ALIGN="LEFT" PORT="updated_at_out"><FONT COLOR="#768370" POINT-SIZE="9">DATETIME</FONT></TD></TR></TABLE>>];
